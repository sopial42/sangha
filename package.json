{
  "name": "sangha",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "./scripts/dev.sh",
    "build": "npm run build -w @sangha/server && npm run build -w @sangha/web",
    "test": "npm test -w @sangha/server && npm test -w @sangha/mcp-bitbucket",
    "lint": "eslint .",
    "typecheck": "tsc -p apps/server --noEmit && tsc -p apps/web --noEmit && tsc -p packages/mcp-bitbucket --noEmit"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "typescript-eslint": "^8.72.2"
  }
}
