# Sangha runs Claude Code on your Claude subscription quota (Pro/Max), never the paid API.
# Generate a long-lived token with:  claude setup-token   (or: make token)
CLAUDE_CODE_OAUTH_TOKEN=

# Never set ANTHROPIC_API_KEY: the server refuses to start if it is present.


# Models (aliases or full ids). Project agents (e.g. kiat-team-lead) use the model of their own definition.
# The orchestrator, the session you talk to (⌘K)
SANGHA_BUDDHA_MODEL=sonnet
# "Team lead" role
SANGHA_LEAD_MODEL=opus
# Subagents of the "Team lead" agent
SANGHA_NOVICE_MODEL=sonnet
# Short recap written when a session stops (one small call per stop), and other summaries
SANGHA_RECAP_MODEL=haiku

# The identity sessions commit with is set in the app (Settings > Git identity), not here.
# GIT_AUTHOR_* / GIT_COMMITTER_* variables are ignored for sessions (they would override it).

# Sessions started outside Sangha (terminal, IDE) stay on the board while active within this many minutes.
SANGHA_EXTERNAL_WINDOW_MIN=90

# Host port for `make up`
SANGHA_PORT=8787

# MCP library (Settings > MCP servers > Sangha library): its servers start switched off and stay on until Sangha restarts.
# Their credentials are asked in the UI and saved in ~/.config/sangha/.env (of whoever runs Sangha, override with SANGHA_ENV_FILE):
#   bitbucket-stdio (packages/mcp-bitbucket, run in stdio)
#     BITBUCKET_MCP_API_BASE_URL, BITBUCKET_MCP_TOKEN (secret), BITBUCKET_MCP_USER_SLUG (optional, to approve / request changes)
