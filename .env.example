# Sangha runs Claude Code on your Claude subscription quota (Pro/Max), never the paid API.
# Generate a long-lived token with:  claude setup-token   (or: make token)
CLAUDE_CODE_OAUTH_TOKEN=

# Never set ANTHROPIC_API_KEY: the server refuses to start if it is present.


# Models (aliases or full ids). Project agents (e.g. kiat-team-lead) use the model of their own definition.
# Buddha, the dispatcher you talk to
SANGHA_BUDDHA_MODEL=sonnet
# "Team lead" role
SANGHA_LEAD_MODEL=opus
# novices of the "Team lead" role
SANGHA_NOVICE_MODEL=sonnet
# micro recap written when a priest stops (one short call per stop)
SANGHA_RECAP_MODEL=haiku

# Identity of the commits priests make: set it in Sangha (« Git » button on the home page), not here.
# GIT_AUTHOR_* / GIT_COMMITTER_* variables are ignored for priests (they would override it).

# Outside Claude Code sessions (terminal, IDE) stay in the courtyard while active within this many minutes.
SANGHA_EXTERNAL_WINDOW_MIN=90

# Host port for `make up`
SANGHA_PORT=8787

# MCP library (🔌 > Bibliothèque): its servers start switched off and stay on until Sangha restarts.
# Their credentials are filled in from the UI and saved here.
# bitbucket-stdio: the mcp-bitbucket server run locally in stdio (its compiled bin/bitbucket-mcp, else src/index.ts through tsx)
BITBUCKET_MCP_DIR=
BITBUCKET_MCP_API_BASE_URL=
# Bitbucket personal access token (secret)
BITBUCKET_MCP_TOKEN=
# Optional: needed only to approve / request changes
BITBUCKET_MCP_USER_SLUG=
